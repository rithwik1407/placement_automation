# Copy to .env for local development. In production, set these as secrets (e.g. Secret Manager).

DATABASE_URL=postgresql+psycopg://placement:password@localhost:5432/placement_agent

# Gmail (read-only). Either a token file path or the token JSON itself.
GMAIL_TOKEN_FILE=secrets/gmail_token.json
# GMAIL_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}
GMAIL_PUBSUB_TOPIC=projects/YOUR_GCP_PROJECT/topics/gmail-placement

# Pub/Sub push authentication
PUBSUB_VERIFY_TOKEN=true
PUBSUB_AUDIENCE=https://YOUR-SERVICE-URL/pubsub/gmail
PUBSUB_SERVICE_ACCOUNT_EMAIL=gmail-push@YOUR_GCP_PROJECT.iam.gserviceaccount.com

# Shared secret sent by Cloud Scheduler in the X-Scheduler-Secret header
SCHEDULER_SECRET=change-me-to-a-long-random-string

# Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# WhatsApp Cloud API
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_RECIPIENT=91XXXXXXXXXX
WHATSAPP_API_VERSION=v23.0
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_NAME=placement_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# Log alerts instead of sending them
DRY_RUN=false
